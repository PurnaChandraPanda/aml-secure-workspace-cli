# ---------------------------------------------------------------------------
# knowledgebase-as-mcp — environment configuration
# Copy to `.env` and fill in PROJECT_RESOURCE_ID. Other keys already default
# to this resource, but are listed here for clarity.
# ---------------------------------------------------------------------------

# REQUIRED — ARM resource id of the Foundry PROJECT.
# Must be the CognitiveServices namespace (NOT MachineLearningServices).
# Form:
#   /subscriptions/<sub>/resourceGroups/<rg>/providers/Microsoft.CognitiveServices/accounts/<acct>/projects/<proj>
PROJECT_RESOURCE_ID=/subscriptions/xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx/resourceGroups/<rg>/providers/Microsoft.CognitiveServices/accounts/aifoundry3738/projects/project3738
PROJECT_ENDPOINT=https://{your-resource-name}.services.ai.azure.com/api/projects/{your-project-name}

# Search service that hosts the Knowledge Base
AZURE_SEARCH_SERVICE=https://{your-search-service}.search.windows.net

# Existing search index name
INDEX_NAME={search-index-name}

# Knowledge Base name (must match what kb_build_knowledge_base.py created)
KNOWLEDGE_BASE_NAME=py-citation-kb

# Name for the RemoteTool project connection created by kb_create_mcp_connection.py
# Keep this identical across the connection-create and agent-create steps.
PROJECT_CONNECTION_NAME=py-citation-kb-mcp-connection

# Azure openai endpoint
AZURE_OPENAI_ENDPOINT=https://{your-foundry-account}.openai.azure.com/

# Semantic config name for KB {one index can have one semantic config}
SEMANTIC_CONFIG_NAME=py-citation-semconfig
# Knowledge source name
KNOWLEDGE_SOURCE_NAME=py-citation-ks
# Knowledge base name
KNOWLEDGE_BASE_NAME=py-citation-kb
